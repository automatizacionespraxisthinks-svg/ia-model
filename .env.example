# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=praxis-ia-model
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-to-a-random-64-char-secret

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/praxis.db

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3
# Razonamiento interno (qwen3.5, deepseek-r1...). false = respuesta directa (recomendado para n8n).
OLLAMA_ENABLE_THINKING=false

# ─── Ollama runtime tuning (CPU-friendly) ────────────────────────────────────
# Tamaño del contexto. 4096 cubre prompts ~3000 tok + 600 de salida.
# Bajar a 2048 si tus prompts son cortos = prefill más rápido.
OLLAMA_NUM_CTX=4096
# Tope máximo de tokens generados por respuesta.
OLLAMA_NUM_PREDICT=600
# Hilos de CPU. Ajusta al nº de cores físicos (no hyperthreads).
OLLAMA_NUM_THREAD=8
# Mantener prompt en caché de prefijo (-1 = sin tope, recomendado).
OLLAMA_NUM_KEEP=-1
# Sampling
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
# Temperature por defecto si el request no la trae.
OLLAMA_DEFAULT_TEMPERATURE=0.3

# ─── Modelos disponibles (separados por coma) ─────────────────────────────────
AVAILABLE_MODELS=qwen3.5,granite4.1
DEFAULT_MODEL=qwen3.5

# ─── Umbrales del router automático (en caracteres) ──────────────────────────
ROUTER_LIGHT_THRESHOLD=500
ROUTER_MEDIUM_THRESHOLD=2000
ROUTER_LIGHT_MODEL=granite4.1
ROUTER_MEDIUM_MODEL=qwen3.5
ROUTER_HEAVY_MODEL=qwen3.5

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Admin ────────────────────────────────────────────────────────────────────
# Clave admin inicial — cámbiala y guárdala en lugar seguro
ADMIN_SECRET=change-this-admin-secret

# ─── Panel web admin (/admin) ────────────────────────────────────────────────
# Credenciales para iniciar sesión en la UI web de gestión de keys
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
